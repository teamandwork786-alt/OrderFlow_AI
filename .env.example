# Demo values only. Never commit real secrets.
DATABASE_URL=postgresql://orderflow_app:app_demo_password@localhost:5432/orderflow
DATABASE_URL_OWNER=postgresql://orderflow_owner:owner_demo_password@localhost:5432/orderflow
DATABASE_URL_READONLY=postgresql://orderflow_ro:ro_demo_password@localhost:5432/orderflow

SHOPIFY_ADAPTER=mock
SHOPIFY_SHOP_DOMAIN=demo-shop.myshopify.com
SHOPIFY_APP_SECRET=demo-shopify-app-secret
# Real mode only:
# SHOPIFY_API_VERSION=
# SHOPIFY_ADMIN_TOKEN=
SHOPIFY_NOTIFY_CUSTOMER=false
SHOPIFY_TIMEOUT_MS=10000

STALE_AFTER_MINUTES=15
WEBHOOK_MAX_ATTEMPTS=8
RECONCILE_INTERVAL_MINUTES=5
RECONCILE_WINDOW_HOURS=48
REPORT_TZ=Asia/Karachi

PORT=3000
LOG_LEVEL=info
ALLOW_DESTRUCTIVE_SEED=false

