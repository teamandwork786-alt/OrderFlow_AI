NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
MOCK_OIDC_PORT=4000

POSTGRES_DB=orderflow
IDENTITY_TEST_DATABASE_NAME=orderflow_test
ORDERFLOW_OWNER_PASSWORD=replace-with-local-owner-password
ORDERFLOW_APP_PASSWORD=replace-with-local-app-password
ORDERFLOW_RO_PASSWORD=replace-with-local-readonly-password
DATABASE_URL_OWNER=postgresql://orderflow_owner:replace-with-local-owner-password@localhost:5432/orderflow
DATABASE_URL=postgresql://orderflow_app:replace-with-local-app-password@localhost:5432/orderflow
DATABASE_URL_READONLY=postgresql://orderflow_ro:replace-with-local-readonly-password@localhost:5432/orderflow

WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
OIDC_ISSUER_URL=http://localhost:4000
OIDC_INTERNAL_URL=http://mock-oidc:4000
OIDC_CLIENT_ID=orderflow-web
OIDC_CLIENT_SECRET=replace-with-local-oidc-client-secret
OIDC_COOKIE_SECRET=replace-with-at-least-32-random-oidc-cookie-characters
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
MOCK_OIDC_DEMO_PASSWORD=replace-with-local-demo-password
BOOTSTRAP_OWNER_SUBJECT=demo-owner
ALLOW_DESTRUCTIVE_SEED=false
IDENTITY_TEST_DATABASE_OWNER_URL=postgresql://orderflow_owner:replace-with-local-owner-password@localhost:5432/orderflow_test
IDENTITY_TEST_DATABASE_APP_URL=postgresql://orderflow_app:replace-with-local-app-password@localhost:5432/orderflow_test
IDENTITY_TEST_DATABASE_RO_URL=postgresql://orderflow_ro:replace-with-local-readonly-password@localhost:5432/orderflow_test
