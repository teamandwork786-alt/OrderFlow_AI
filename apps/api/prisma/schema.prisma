// Prisma schema mirroring prisma/migrations (the SQL migrations are authoritative: they hold the
// partial unique indexes, triggers and CHECK constraints Prisma cannot express).
// Use `prisma migrate deploy` only. NEVER `prisma db push`: it would drop those custom objects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  oidcSubject String     @unique @map("oidc_subject")
  email       String?
  displayName String?    @map("display_name")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       UserRole[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  isSystem    Boolean          @default(true) @map("is_system")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Order {
  id                        String    @id @default(uuid()) @db.Uuid
  shopifyOrderId            String    @unique @map("shopify_order_id")
  shopifyOrderNumber        String    @map("shopify_order_number")
  customerName              String?   @map("customer_name")
  customerEmail             String?   @map("customer_email")
  customerPhone             String?   @map("customer_phone")
  shopifyShippingAddress    Json?     @map("shopify_shipping_address")
  currency                  String
  subtotalAmount            Decimal   @map("subtotal_amount") @db.Decimal(12, 2)
  shippingAmount            Decimal   @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount               Decimal   @map("total_amount") @db.Decimal(12, 2)
  shopifyFinancialStatus    String    @map("shopify_financial_status")
  shopifyFulfillmentStatus  String?   @map("shopify_fulfillment_status")
  shopifyCancelledAt        DateTime? @map("shopify_cancelled_at") @db.Timestamptz(6)
  shopifyUpdatedAt          DateTime  @map("shopify_updated_at") @db.Timestamptz(6)
  lastSyncedAt              DateTime  @map("last_synced_at") @db.Timestamptz(6)
  eligibilityStatus         String    @default("PENDING_VERIFICATION") @map("eligibility_status")
  eligibilityReasonCode     String?   @map("eligibility_reason_code")
  lifecycleStatus           String    @default("PENDING_PAYMENT") @map("lifecycle_status")
  orderVersion              Int       @default(1) @map("order_version")
  paymentVerifiedAt         DateTime? @map("payment_verified_at") @db.Timestamptz(6)
  dispatchedAt              DateTime? @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt               DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveredBy               String?   @map("delivered_by") @db.Uuid
  addressOverride           Json?     @map("address_override")
  addressOverrideBy         String?   @map("address_override_by") @db.Uuid
  addressOverrideAt         DateTime? @map("address_override_at") @db.Timestamptz(6)
  addressOverrideReason     String?   @map("address_override_reason") @db.VarChar(200)
  shopifyConflictFlag       Boolean   @default(false) @map("shopify_conflict_flag")
  shopifyConflictReviewedAt DateTime? @map("shopify_conflict_reviewed_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items      OrderItem[]
  checklist  ChecklistStep[]
  dispatches Dispatch[]
  notes      OrderNote[]
  audit      AuditEvent[]
  refunds    RefundApplication[]

  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  shopifyLineItemId String  @map("shopify_line_item_id")
  productId         String? @map("product_id")
  variantId         String? @map("variant_id")
  productTitle      String  @map("product_title")
  variantTitle      String? @map("variant_title")
  sku               String?
  quantity          Int
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)
  order             Order   @relation(fields: [orderId], references: [id])

  @@unique([orderId, shopifyLineItemId])
  @@map("order_items")
}

model ChecklistStep {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  stepNumber  Int       @map("step_number")
  stepKey     String    @map("step_key")
  label       String
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy String?   @map("completed_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order       Order     @relation(fields: [orderId], references: [id])

  @@unique([orderId, stepNumber])
  @@map("checklist_steps")
}

model Dispatch {
  id                     String    @id @default(uuid()) @db.Uuid
  orderId                String    @map("order_id") @db.Uuid
  requestId              String    @unique @map("request_id") @db.Uuid
  requestHash            String    @map("request_hash")
  status                 String
  trackingNumber         String?   @map("tracking_number")
  shopifyFulfillmentId   String?   @unique @map("shopify_fulfillment_id")
  attemptCount           Int       @default(0) @map("attempt_count")
  lastErrorCode          String?   @map("last_error_code")
  lastErrorMessage       String?   @map("last_error_message")
  requestedBy            String    @map("requested_by") @db.Uuid
  requestedAt            DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  confirmedAt            DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastCheckedAt          DateTime? @map("last_checked_at") @db.Timestamptz(6)
  negativeCheckCount     Int       @default(0) @map("negative_check_count")
  precheckFulfillmentIds Json      @default("[]") @map("precheck_fulfillment_ids")
  deliveryNote           String?   @map("delivery_note") @db.VarChar(200)
  order                  Order     @relation(fields: [orderId], references: [id])

  @@map("dispatches")
}

model WebhookInbox {
  id                 String    @id @default(uuid()) @db.Uuid
  shopifyWebhookId   String    @unique @map("shopify_webhook_id")
  shopifyEventId     String?   @map("shopify_event_id")
  topic              String
  shopDomain         String    @map("shop_domain")
  apiVersion         String?   @map("api_version")
  shopifyTriggeredAt DateTime? @map("shopify_triggered_at") @db.Timestamptz(6)
  resourceId         String?   @map("resource_id")
  payload            Json
  status             String    @default("RECEIVED")
  attemptCount       Int       @default(0) @map("attempt_count")
  receivedAt         DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt        DateTime? @map("processed_at") @db.Timestamptz(6)
  nextRetryAt        DateTime  @default(now()) @map("next_retry_at") @db.Timestamptz(6)
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  lastErrorCode      String?   @map("last_error_code")
  lastErrorMessage   String?   @map("last_error_message")

  @@index([status, nextRetryAt])
  @@map("webhook_inbox")
}

model RefundApplication {
  id                         String    @id @default(uuid()) @db.Uuid
  orderId                    String    @map("order_id") @db.Uuid
  applicationNumber          String    @unique @map("application_number")
  applicationType            String    @map("application_type")
  status                     String    @default("SUBMITTED")
  reasonCode                 String    @map("reason_code")
  customerReason             String?   @map("customer_reason")
  requestedAt                DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  submittedBy                String    @map("submitted_by") @db.Uuid
  requestId                  String    @unique @map("request_id") @db.Uuid
  requestHash                String    @map("request_hash")
  reviewedBy                 String?   @map("reviewed_by") @db.Uuid
  reviewedAt                 DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote                 String?   @map("review_note")
  manualDeliveryChargeAmount Decimal?  @map("manual_delivery_charge_amount") @db.Decimal(12, 2)
  manualApprovedAmount       Decimal?  @map("manual_approved_amount") @db.Decimal(12, 2)
  currency                   String
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                      Order     @relation(fields: [orderId], references: [id])
  items                      RefundApplicationItem[]

  @@map("refund_applications")
}

model RefundApplicationItem {
  id                   String            @id @default(uuid()) @db.Uuid
  refundApplicationId  String            @map("refund_application_id") @db.Uuid
  orderItemId          String?           @map("order_item_id") @db.Uuid
  productTitleSnapshot String            @map("product_title_snapshot")
  variantTitleSnapshot String?           @map("variant_title_snapshot")
  skuSnapshot          String?           @map("sku_snapshot")
  requestedQuantity    Int               @map("requested_quantity")
  reasonNote           String?           @map("reason_note")
  application          RefundApplication @relation(fields: [refundApplicationId], references: [id])

  @@map("refund_application_items")
}

model OrderNote {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  kind      String
  note      String   @db.VarChar(500)
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("order_notes")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  actorType String   @map("actor_type")
  actorId   String?  @map("actor_id") @db.Uuid
  eventType String   @map("event_type")
  details   Json     @default("{}")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt, id])
  @@map("audit_events")
}

model IntegrationState {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("integration_state")
}

model WorkerHeartbeat {
  workerName String   @id @map("worker_name")
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)

  @@map("worker_heartbeats")
}

model MockShopifyOrder {
  shopifyOrderId String   @id @map("shopify_order_id")
  data           Json
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("mock_shopify_orders")
}

model MockControl {
  key   String @id
  value String

  @@map("mock_controls")
}
