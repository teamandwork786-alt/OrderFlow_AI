{
  "name": "orderflow-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/api",
    "apps/analytics",
    "apps/mock-oidc",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "api:types": "openapi-typescript api-spec/openapi.yaml -o packages/shared/src/api-types.d.ts",
    "build": "npm run db:generate && npm run build --workspace @orderflow/shared && npm run build --workspace @orderflow/api && npm run build --workspace @orderflow/mock-oidc && npm run build --workspace @orderflow/web",
    "db:migrate": "node --env-file-if-exists=.env.example --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --import tsx apps/api/scripts/seed.ts",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env.example --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:e2e": "node --env-file-if-exists=.env.example --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:sql": "node --env-file-if-exists=.env.example --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.sql.config.ts",
    "typecheck": "npm run db:generate && npm run build --workspace @orderflow/shared && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/mock-oidc/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "db:generate": "npm run db:generate --workspace @orderflow/api",
    "pretest": "npm run db:generate",
    "pretest:sql": "npm run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "openapi-typescript": "^7.8.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^5.1.2"
  }
}
